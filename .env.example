# Copy to .env and fill in your key.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Claude models
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Voice transcription: "local" (offline, no key) or "groq"
WHISPER_BACKEND=local
WHISPER_MODEL=base
GROQ_API_KEY=

# Storage / server
# Port 5050 (5000 is taken by macOS AirPlay Receiver)
DB_PATH=data/good_memory.db
FLASK_DEBUG=true
PORT=5050
